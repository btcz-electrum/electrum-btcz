# If you want BitcoinZ Electrum to appear in a Linux app launcher ("start menu"), install this by doing:
# sudo desktop-file-install electrum-btcz.desktop

[Desktop Entry]
Comment=BitcoinZ Electrum Wallet
Exec=sh -c "PATH=\"\\$HOME/.local/bin:\\$PATH\"; electrum-btcz %u"
GenericName[en_US]=BitcoinZ Electrum
GenericName=BitcoinZ Electrum
Icon=electrum-btcz
Name[en_US]=BitcoinZ Electrum
Name=BitcoinZ Electrum
Categories=Network;
StartupNotify=true
StartupWMClass=btcz-electrum
Terminal=false
Type=Application
MimeType=x-scheme-handler/zcash;
Actions=Testnet;

[Desktop Action Testnet]
Exec=sh -c "PATH=\"\\$HOME/.local/bin:\\$PATH\"; electrum-btcz --testnet %u"
Name=Testnet mode
