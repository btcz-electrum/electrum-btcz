include LICENCE RELEASE-NOTES AUTHORS
include README.rst
include electrum-btcz.desktop
include *.py
include electrum-btcz
recursive-include packages *.py
recursive-include packages cacert.pem
graft debian

include contrib/requirements/requirements*.txt
include contrib/deterministic-build/requirements*.txt
include contrib/make_libsecp256k1.sh
include contrib/build_tools_util.sh

graft electrum_btcz
graft contrib/udev

exclude electrum_btcz/*.so
exclude electrum_btcz/*.so.0
exclude electrum_btcz/*.dll
exclude electrum_btcz/*.dylib

global-exclude __pycache__
global-exclude *.py[co~]
global-exclude *.py.orig
global-exclude *.py.rej
global-exclude .git
